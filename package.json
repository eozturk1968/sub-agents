{
  "name": "sub-agents",
  "version": "0.4.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Erdinc Ozturk",
  "description": "Drag AI models onto a canvas and make them sub-agents of a group leader.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.5.0",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.erdincozturk.subagents",
    "productName": "Sub-Agents",
    "copyright": "Copyright © 2026 Erdinc Ozturk. All rights reserved.",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "harness.js",
      "roles.js",
      "files.js",
      "platform.js",
      "ptys.js",
      "models.json",
      "bin/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**",
      "node_modules/@lydell/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Sub-Agents"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sub-Agents"
    },
    "npmRebuild": false
  }
}
